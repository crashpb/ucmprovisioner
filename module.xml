<module>
    <rawname>ucmprovisioner</rawname>
    <repo>unsupported</repo>
    <name>UCM Provisioner</name>
    <version>1.1.0rc33</version>
    <publisher>crashpb</publisher>
    <license>GPLv3+</license>
    <licenselink>https://www.gnu.org/licenses/gpl-3.0.txt</licenselink>
    <type>setup</type>
    <category>Connectivity</category>
    <description>
        Multi-site phone provisioning for Cisco enterprise phones on
        USECALLMANAGER-patched Asterisk, Cisco legacy SIP phones, Yealink and
        Grandstream devices. Includes model-aware templates, BLF federation,
        Active Directory phonebooks, transactional configuration builds, managed
        TFTP/media/firmware/timezone assets, phone services, patch management,
        site replication, discovery, operational status and Fail2ban controls.
    </description>
    <menuitems>
        <ucmprovisioner needsenginedb="yes" category="Connectivity">UCM Provisioner</ucmprovisioner>
    </menuitems>
    <depends>
        <phpversion>8.2.0</phpversion>
        <module>framework ge 17.0.1</module>
        <module>core ge 17.0.1</module>
    </depends>
    <hooks>
        <framework class="Chown" namespace="FreePBX\Console\Command">
            <method callingMethod="fwcChownFiles" class="Ucmprovisioner" namespace="FreePBX\modules">chownFreepbx</method>
        </framework>
    </hooks>
